{
    "expo":  {
                 "name":  "RotaFit",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "automatic",
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-location",
                                     {
                                         "locationAlwaysAndWhenInUsePermission":  "O RotaFit usa sua localizaÃ§Ã£o para registrar a rota e o ritmo da corrida."
                                     }
                                 ],
                                 "expo-secure-store",
                                 "expo-web-browser",
                                 "expo-font"
                             ],
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.joaoemanuelp.rotafit",
                             "infoPlist":  {
                                               "NSLocationWhenInUseUsageDescription":  "O RotaFit usa sua localizaÃ§Ã£o para registrar a rota da corrida."
                                           }
                         },
                 "android":  {
                                 "package":  "com.joaoemanuelp.rotafit",
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#B81104",
                                                      "foregroundImage":  "./assets/android-icon-foreground.png",
                                                      "backgroundImage":  "./assets/android-icon-background.png",
                                                      "monochromeImage":  "./assets/android-icon-monochrome.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "permissions":  [
                                                     "ACCESS_FINE_LOCATION",
                                                     "ACCESS_COARSE_LOCATION"
                                                 ]
                             },
                 "slug":  "rotafit",
                 "scheme":  "rotafit"
             }
}
